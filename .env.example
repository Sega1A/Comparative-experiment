# Copie este archivo a .env y ajuste los valores. El .env real no se sube a Git.

# Credenciales que usa el contenedor de PostgreSQL (servicio "db" de compose.yaml)
POSTGRES_USER=alertas
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=alertas

# Puerto de PostgreSQL en su máquina. Si ya tiene otro PostgreSQL instalado
# usando el 5432, ponga 5433 aquí y también en DATABASE_URL.
POSTGRES_PUERTO=5432

# Conexión de SQLAlchemy (driver psycopg v3).
# Desde su máquina (fuera de Docker) el host es localhost:
DATABASE_URL=postgresql+psycopg://alertas:cambiar_esta_clave@localhost:5432/alertas
# Desde otro contenedor de Docker Compose el host es el servicio "db":
# DATABASE_URL=postgresql+psycopg://alertas:cambiar_esta_clave@db:5432/alertas

# --- Opcionales (los servidores usan estos valores por defecto) ---

# Broker MQTT. Con el código en su máquina el host es localhost; dentro de
# Docker Compose lo fija compose.yaml (servicio "mosquitto").
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC=alert

# Escenario de red de la prueba (se guarda en la columna perfil_red; vacío = sin perfil).
NETWORK_PROFILE=

# Nivel de los logs: DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO
